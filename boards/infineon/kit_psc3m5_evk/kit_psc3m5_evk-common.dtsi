/*
 * Common devicetree content for the kit_psc3m5_evk secure board variants.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "The Infineon PSOC™ Control C3M5 Evaluation Kit";
	compatible = "infineon,kit_psc3m5_evk", "infineon,PSC3M5";

	aliases {
		led0 = &user_led0;
		led1 = &user_led1;
		sw0 = &user_bt0;
		sw1 = &user_bt1;
		watchdog0 = &watchdog0;
	};

	leds {
		compatible = "gpio-leds";

		user_led0: led_0 {
			label = "LED_0";
			gpios = <&gpio_prt8 5 GPIO_ACTIVE_LOW>;
		};

		user_led1: led_1 {
			label = "LED_1";
			gpios = <&gpio_prt8 4 GPIO_ACTIVE_LOW>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_bt0: user_btn0 {
			label = "SW_1";
			gpios = <&gpio_prt5 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_bt1: user_btn1 {
			label = "SW_2";
			gpios = <&gpio_prt2 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&gpio_prt0 {
	status = "okay";
};

&gpio_prt1 {
	status = "okay";
};

&gpio_prt2 {
	status = "okay";
};

&gpio_prt3 {
	status = "okay";
};

&gpio_prt5 {
	status = "okay";
};

&gpio_prt6 {
	status = "okay";
};

&gpio_prt8 {
	status = "okay";
};

uart3: &scb3 {
	compatible = "infineon,uart";
	status = "okay";
	current-speed = <115200>;

	/* Leaf peripheral (baud) divider owned by the UART driver. */
	clocks = <&peri0_group4_8bit_0>;

	/*
	 * Shared source clock (clk_hf2) owned by the clock-management framework.
	 * The driver applies the default state to bring up path_mux2 -> dpll_lp1
	 * -> clk_hf2 and reads the resulting rate through clock management.
	 */
	clock-outputs = <&clk_hf2_output>;
	clock-output-names = "periclk";
	clock-state-0 = <&clk_hf2_default>;
	clock-state-names = "default";

	pinctrl-0 = <&p6_3_scb3_uart_tx &p6_2_scb3_uart_rx &p6_1_scb3_uart_rts &p6_0_scb3_uart_cts>;
	pinctrl-names = "default";
};

&peri0_group4_8bit_0 {
	status = "okay";
	clock-div = <86>;
};

&peri0_group4_16_5bit_0 {
	status = "okay";
	clock-div = <1>;
};

&canfd0 {
	status = "okay";
};

&can1 {
	status = "okay";
	clocks = <&peri0_group4_16_5bit_0>;
	pinctrl-0 = <&p5_2_can1_rx &p5_3_can1_tx>;
	pinctrl-names = "default";
};

&watchdog0 {
	status = "okay";
};

&mcwdt0 {
	status = "okay";
};

/*
 * The full clock tree (sources, path muxes, FLL, DPLLs, clk_hf roots, and
 * low-frequency domains) is modelled at SoC scope in system_clocks_cm.dtsi.
 * The board only overrides the peripheral divider defaults above and declares
 * the CPU system-clock consumer below.
 */

/*
 * The CPU is the consumer of the system clock (clk_hf0). The SoC init applies
 * this state at boot to bring the core up to 180 MHz, since an always-on system
 * clock has no peripheral driver to own it.
 */
&cpu0 {
	clock-outputs = <&clk_hf0_output>;
	clock-output-names = "default";
	clock-state-0 = <&clk_hf0_default>;
	clock-state-names = "default";
};
